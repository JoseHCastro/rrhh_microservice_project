AWS_SECRET_ACCESS_KEY=tu_secret_key
AWS_S3_BUCKET=rrhh-preplanillas-dev
DYNAMODB_TABLE_AUDITORIA=rrhh_bitacora

# ══ FIREBASE FCM ══
FCM_ENABLED=false
FCM_PROJECT_ID=rrhh-project
FCM_CREDENTIALS_PATH=./firebase-service-account.json

# ══ SPRING BOOT ══
SERVER_PORT=8080
LOG_LEVEL=DEBUG
SPRING_PROFILES_ACTIVE=dev
