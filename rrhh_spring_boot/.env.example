# ══ BASE DE DATOS ══
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rrhh_db
DB_USERNAME=rrhh_user
DB_PASSWORD=rrhh_password
DB_POOL_MAX=10
DB_POOL_MIN=2

# ══ JWT ══
JWT_SECRET=bXlTdXBlclNlY3JldEtleUZvckpXVEF1dGhlbnRpY2F0aW9uU3lzdGVtMjAyNQ==
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ══ CORS ══
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# ══ GRAPHQL ══
GRAPHIQL_ENABLED=true
GRAPHQL_PATH=/graphql

# ══ AWS (Deshabilitado en local por defecto) ══
AWS_ENABLED=false
AWS_REGION=us-east-1
