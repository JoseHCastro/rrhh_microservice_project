# ════════════════════════════════════════════════════════════════════════════
#  Módulo 3 — Plantilla de variables de entorno para el despliegue en la nube
#
#  ⚠️  PLANTILLA. NO contiene secretos reales — solo placeholders.
#      Copia este archivo como `.env` EN LA VM, rellena los valores reales y
#      NUNCA lo subas al repo (el `.env` está ignorado por .gitignore).
#
#      cp .env.cloud.example .env   &&   nano .env
# ════════════════════════════════════════════════════════════════════════════

# ──────────── Servidor ────────────
NODE_ENV=production
PORT=3000

# ──────────── Base de datos: Neon (Postgres serverless) ────────────
# Usa la cadena POOLED de Neon (incluye "-pooler") y sslmode=require.
# Formato: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&schema=seguridad
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/rrhh_db?sslmode=require&schema=seguridad

# ──────────── URLs públicas ────────────
# FQDN público del NEST (para los enlaces de aprobación que van al correo).
# = IP pública de la VM de Azure o tu dominio. Ej: http://20.10.30.40:3000
PUBLIC_BASE_URL=http://TU-IP-PUBLICA-VM:3000
# URL interna de n8n dentro de la red docker de la VM (no cambiar si usas este compose).
N8N_BASE_URL=http://n8n:5678

# ──────────── JWT (DEBE ser idéntico al de Spring Boot — Módulo 2) ────────────
# Mismo secret Base64 que el microservicio de Java; el Nest solo valida tokens.
JWT_SECRET=PON_AQUI_EL_MISMO_JWT_SECRET_BASE64_DEL_SPRING_BOOT
JWT_EXPIRATION_MS=86400000

# ──────────── Telegram ────────────
# Token del bot (@BotFather). Mismo bot que usa n8n.
TELEGRAM_BOT_TOKEN=PON_AQUI_EL_TOKEN_DEL_BOT

# ──────────── IA — análisis de justificaciones (opt-in) ────────────
IA_ANALISIS_HABILITADO=true
GEMINI_API_KEY=PON_AQUI_TU_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# ──────────── n8n (webhook seguro) ────────────
# DEBE coincidir con N8N_WEBHOOK_SECRET del servicio n8n en docker-compose.cloud.yml.
N8N_WEBHOOK_SECRET=PON_AQUI_UN_SECRET_FUERTE

# ──────────── AWS S3 (bucket real del equipo) ────────────
# Endpoint vacío => SDK usa AWS real. force_path_style=false para AWS S3.
AWS_S3_ENDPOINT=
AWS_S3_REGION=us-east-2
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_ACCESS_KEY_ID=PON_AQUI_AWS_ACCESS_KEY_ID
AWS_S3_SECRET_ACCESS_KEY=PON_AQUI_AWS_SECRET_ACCESS_KEY
AWS_S3_FORCE_PATH_STYLE=false
S3_PRESIGNED_URL_EXPIRES_SECONDS=300

# ──────────── AWS DynamoDB (tabla de bitácora, real y compartida) ────────────
# Endpoint vacío => AWS real (no contenedor local).
DYNAMODB_ENDPOINT=
DYNAMODB_REGION=us-east-2
DYNAMODB_ACCESS_KEY_ID=PON_AQUI_DYNAMODB_ACCESS_KEY_ID
DYNAMODB_SECRET_ACCESS_KEY=PON_AQUI_DYNAMODB_SECRET_ACCESS_KEY
DYNAMODB_TABLE_BITACORA=BitacoraAuditoria
DYNAMODB_GSI1_NAME=GSI1PK-GSI1SK-index
BITACORA_TTL_DAYS=365

# ──────────── Aprobación por correo ────────────
# Vigencia (horas) de los tokens de un solo uso de los enlaces aprobar/rechazar.
APROBACION_TOKEN_TTL_HORAS=168

# ──────────── CORS ────────────
# Orígenes permitidos (front Angular, app, etc.), separados por coma.
CORS_ALLOWED_ORIGINS=http://TU-IP-PUBLICA-VM:3000,http://localhost:4200
