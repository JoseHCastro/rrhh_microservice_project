# ══════════ SERVIDOR ══════════
PORT=3000
NODE_ENV=development

# ══════════ POSTGRES (mismo rrhh_db que Spring Boot, schema "seguridad") ══════════
# Para correr dentro de docker compose: DB_HOST=postgres
# Para correr localmente con Spring Boot apagado: DB_HOST=localhost
DB_HOST=postgres
DB_PORT=5432
DB_NAME=rrhh_db
DB_USER=rrhh
DB_PASS=123
# Prisma usa esta URL completa (compuesta de las variables anteriores)
DATABASE_URL=postgresql://rrhh:123@postgres:5432/rrhh_db?schema=seguridad

# ══════════ JWT (DEBE coincidir con el de rrhh_spring_boot) ══════════
JWT_SECRET=bXlTdXBlclNlY3JldEtleUZvckpXVEF1dGhlbnRpY2F0aW9uU3lzdGVtMjAyNQ==
JWT_EXPIRATION_MS=86400000

# ══════════ S3 / MinIO (modo desarrollo) ══════════
# AWS_S3_ENDPOINT vacío => usa AWS real. Con valor => MinIO local.
AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=rrhh-archivos-dev
AWS_S3_ACCESS_KEY_ID=minioadmin
AWS_S3_SECRET_ACCESS_KEY=minioadmin
AWS_S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_EXPIRES_SECONDS=300

# ══════════ DynamoDB (local en docker compose) ══════════
DYNAMODB_ENDPOINT=http://dynamodb:8000
DYNAMODB_REGION=us-east-1
DYNAMODB_ACCESS_KEY_ID=local
DYNAMODB_SECRET_ACCESS_KEY=local
DYNAMODB_TABLE_BITACORA=rrhh_bitacora_auditoria
DYNAMODB_GSI1_NAME=GSI1-Documento
BITACORA_TTL_DAYS=365

# ══════════ n8n ══════════
N8N_WEBHOOK_SECRET=cambiame-en-prod
N8N_BASE_URL=http://n8n:5678

# ══════════ CORS ══════════
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:8081

# ══════════ IA (análisis de justificaciones — OPT-IN) ══════════
# true => analiza el documento con la IA. Requiere GEMINI_API_KEY.
# Provider intercambiable (Gemini hoy; Azure OpenAI para la entrega final).
IA_ANALISIS_HABILITADO=false
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
GEMINI_MODEL=gemini-2.0-flash

# ══════════ Aprobación por correo ══════════
PUBLIC_BASE_URL=http://localhost:3000
APROBACION_TOKEN_TTL_HORAS=168

# ══════════ Telegram (aviso de resultado al empleado) ══════════
# Token del bot (el mismo que usa n8n). Créalo con @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AA...tu_token
